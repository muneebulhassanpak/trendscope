# Supabase — Project Settings → API Keys (or `npx supabase status` for the local stack)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: market data sync and demo seeding. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Bearer token for /api/cron/sync (min 16 chars)
CRON_SECRET=

# Read-only demo account used by "Explore as demo admin"
DEMO_USER_EMAIL=demo@trendscope.dev
DEMO_USER_PASSWORD=

# Optional: real admin account created by `npm run data:seed` (local/CI testing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
